<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>My-tool</AssemblyName>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\..\release</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CodePage>65001</CodePage>
  </PropertyGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)MyTool.exe" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)Split-Slab.exe" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)AppSplitSlab.exe" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)Change-shape.exe" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)AppChangeShape.exe" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Reference Include="Tekla.Structures">
      <HintPath>$(TeklaDir)\Tekla.Structures.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tekla.Structures.Model">
      <HintPath>$(TeklaDir)\Tekla.Structures.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
