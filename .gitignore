# ====================================================================
# .gitignore for Tekla-Addin (.NET Framework 4.8 / Tekla Open API / C#)
# ====================================================================

# --------------------------------------------------------------------
# Build Outputs & Intermediate Files
# --------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Aa]rms/
[Aa]rm64/
x64/
x86/
[Dd]ebug/
[Rr]elease/
[Dd]ist/
*.zip
*.binlog

# --------------------------------------------------------------------
# Visual Studio / IDE & User Settings
# --------------------------------------------------------------------
.vs/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
UpgradeLog*.XML
UpgradeLog*.htm

# --------------------------------------------------------------------
# Debugging & Symbol Files
# --------------------------------------------------------------------
*.pdb
*.ilk
*.idb
*.dSYM/
*.opendb
*.db

# --------------------------------------------------------------------
# Temporary, Backup & Log Files
# --------------------------------------------------------------------
*.tmp
*.bak
*.old
*.log
*.tlog
*.cache
*.swp
*~
Thumbs.db
[Dd]esktop.ini

# --------------------------------------------------------------------
# Tekla Structures Logs & Crash Dumps
# --------------------------------------------------------------------
TeklaStructures_*.log
*.dump
CrashDump*.dmp
TeklaModel.log

# --------------------------------------------------------------------
# Dependency DLLs Preservation
# (Preserve vendor & internal GeometryHelper/Xbim assemblies in libs/)
# --------------------------------------------------------------------
!/libs/**
!/libs/**/*.dll
!/libs/**/*.so
!/libs/**/*.dylib

# Re-ignore any DLLs/EXEs generated in source build output folders
src/**/[Bb]in/**
src/**/[Oo]bj/**
