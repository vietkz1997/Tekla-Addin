<?xml version="1.0" encoding="utf-8"?>
<DwgExportOptions Version="1.1">
  <FileAttributes FileExtension=".dwg" FilePrefix="" FileSuffix="" FileVersion="Dwg.UI.DwgFileVersion.vAC24" />
  <Preferences OpenFolder="false" OutputDirectory=".\CAD" UpdateExisting="false" EmbedImages="true" WithoutBlocks="false" SnapshotToModelSpace="true" SnapshotScale="1.0" CoordinatesToUse="Local" />
  <LayerRules>&lt;?xml version="1.0" encoding="utf-16"?&gt;
&lt;ObjectMappingRules xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"&gt;
  &lt;LayerTemplate /&gt;
  &lt;Version&gt;1.0&lt;/Version&gt;
  &lt;MappingRules&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="1-PART" /&gt;
      &lt;Filter ObjectType="Part" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="2-BOLT" /&gt;
      &lt;Filter ObjectType="Bolt" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="3-GRID" /&gt;
      &lt;Filter ObjectType="GridLine" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="4-DIMENSION" /&gt;
      &lt;Filter ObjectType="DimensionBase" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="5-MARK" /&gt;
      &lt;Filter ObjectType="MarkBase" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="6-TEMPLATE" /&gt;
      &lt;Filter ObjectType="DrawingTable" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="7-GRAPHIC OBJECT" /&gt;
      &lt;Filter ObjectType="GraphicObject" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="0" /&gt;
      &lt;Filter ObjectType="DrawingObject" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
  &lt;/MappingRules&gt;
&lt;/ObjectMappingRules&gt;</LayerRules>
</DwgExportOptions>