        valuefield _tmp_6181
        {
            name = "WeldType1";
            location = (33, 36);
            formula = "if GetValue(\"WELD_TYPE1\") == \"W1\" then GetValue(\"TranslatedText(\"albl_Edge_flange\")\")\n else if GetValue(\"WELD_TYPE1\") == \"W2\" then GetValue(\"TranslatedText(\"albl_Square_groove\")\")\n else if GetValue(\"WELD_TYPE1\") == \"W3\" then GetValue(\"TranslatedText(\"albl_Single_V_butt\")\")\n else if GetValue(\"WELD_TYPE1\") == \"W4\" then GetValue(\"TranslatedText(\"albl_Single_bevel_butt\")\")\n else if GetValue(\"WELD_TYPE1\") == \"W5\" then GetValue(\"TranslatedText(\"albl_Single_V_butt\")\")\n else if GetValue(\"WELD_TYPE1\") == \"W6\" then GetValue(\"TranslatedText(\"albl_Single_bevel_butt\")\")\n else if GetValue(\"WELD_TYPE1\") == \"W7\" then GetValue(\"TranslatedText(\"albl_Single_U_butt\")\")\n else if GetValue(\"WELD_TYPE1\") == \"W8\" then GetValue(\"TranslatedText(\"albl_Single_U_butt\")\")\n else if GetValue(\"WELD_TYPE1\") == \"W9\" then GetValue(\"TranslatedText(\"albl_Bevel_backing\")\")\n else GetFieldFormula(\"WT1_10\")\nendif\nendif\nendif\nendif\nendif\nendif\nendif\nendif\nendif";
            datatype = STRING;
