// Product finishes
// -------------------------
//
// Type         : Type of surfacing
//                  1 = concrete finish
//                  2 = special mix
//                  3 = tile surface
//                  4 = steel finish
// Code         : Abbreviation code used in drawings and reports
// Name         : This is the name used in reports


// =========================================
// *** Concrete Finish
// =========================================
//
// WATERPROOFING
// ----------
1		AW	"Acrylic Waterproofing"
1		RW	"Rubber Waterproofing"
1		MW	"Membrane Waterproofing"
1		IW	"Integral Waterproofing"
1		CW	"Cementitious Waterproofing"
1		BW	"Bentonite Waterproofing"
1		SW	"Self-adhering Waterproofing"
1		DW	"Drainage Panel Waterproofing"
1		EW	"Elastomeric Waterproofing"
1		BW	"Bitumi Waterproofing"
//
// WET FINISH
// ----------
1            MF       "Magnesium Float"
1            SMF      "Smooth Magnesium Float"
1            WT       "Wet Trowel"
1            HT       "Hard Trowel"
1            LB       "Light Broom"
1            SUF      "Standard Untopped Finish"
1            RF       "Raked Finish"
//
