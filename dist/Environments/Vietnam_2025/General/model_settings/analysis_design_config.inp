//-------------------------------------------------------------
// Concrete design code dependent factors for BAEL :
// Factors[1] = Compressive strength fck
// Factors[2] = Partial safety factor
// Factors[3] = Modulus of elasticity
// Factors[4] = Creep factor f(t, t0)
// Factors[5] = >0 : maximum admitted concrete compressive stress under rare combinations; -1 : no maximum
// Factors[6] = 1 : maximum admitted concrete compressive stress under rare combinations is after creep; -1 : maximum admitted concrete compressive stress under rare combinations is not after creep 
// Factors[7] = 1 : Verify buckling for additional excentricity; -1 : Not verify buckling
// Factors[8] = additional excentricity
// Factors[9] = Cracking is 0.0 : harmless; 1.0 : harmful; 2.0 : very harmful
// 
// Reinforcement factors
// Factors[10] = Longitudal reinforcement fyk
// Factors[11] = Transverse reinforcement fywk
// Factors[12] = Partial safety factor
// Factors[13] = Gross reinforcement cover
// Factors[14] = Minimum reinforcement ratio
// Factors[15] = Maximum total reinforcement ratio
// Factors[16] = X so that we limit the steel stresses (Rare combinations) to X.fyk
