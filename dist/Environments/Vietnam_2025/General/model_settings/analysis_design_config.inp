//-------------------------------------------------------------
// Concrete design code dependent factors for EC2, DIN1045E, NBN, EC2NL:
// Factors[1] = Compressive strength fck
// Factors[2] = Partial safety factor
// Factors[3] = Modulus of elasticity
// Factors[4] = Creep factor f(t, t0)
// Factors[5] = >0 : maximum admitted concrete compressive stress under rare combinations; -1 : no maximum
// Factors[6] = 1 : maximum admitted concrete compressive stress under rare combinations is after creep; -1 : maximum admitted concrete compressive stress under rare combinations is not after creep 
// Factors[7] = >0 : maximum admitted concrete compressive stress under quasi-permanent combinations; -1 : no maximum
// Factors[8] = 1 : maximum admitted concrete compressive stress under quasi-permanent combinations is after creep; -1 : maximum admitted concrete compressive stress under quasi-permanent combinations is not after creep 
// Factors[9] = the factor of the concrete shear resistance that is taken into account.
// Factors[10] = 1 : Verify buckling for additional excentricity; -1 : Not verify buckling
// Factors[11] = additional excentricity
//
// Reinforcement factors
// Factors[12] = Longitudal reinforcement fyk
// Factors[13] = Transverse reinforcement fywk
// Factors[14] = Partial safety factor
// Factors[15] = Gross reinforcement cover
// Factors[16] = Minimum reinforcement ratio
// Factors[17] = Maximum total reinforcement ratio
// Factors[18] = X so that we limit the steel stresses (Rare combinations) to X.fyk
ConcreteDesignCodeFactor_EC2[1]=25000000.0
ConcreteDesignCodeFactor_EC2[2]=1.5
ConcreteDesignCodeFactor_EC2[3]=30472000000.0
ConcreteDesignCodeFactor_EC2[4]=1.29
ConcreteDesignCodeFactor_EC2[5]=15000000.0
ConcreteDesignCodeFactor_EC2[6]=1.0
ConcreteDesignCodeFactor_EC2[7]=11250000.
ConcreteDesignCodeFactor_EC2[8]=1.0
ConcreteDesignCodeFactor_EC2[9]=1.0
ConcreteDesignCodeFactor_EC2[10]=1.0
ConcreteDesignCodeFactor_EC2[11]=0.020
ConcreteDesignCodeFactor_EC2[12]=500000000.0
ConcreteDesignCodeFactor_EC2[13]=500000000.0
ConcreteDesignCodeFactor_EC2[14]=1.15
ConcreteDesignCodeFactor_EC2[15]=0.035
ConcreteDesignCodeFactor_EC2[16]=0.0015
ConcreteDesignCodeFactor_EC2[17]=0.04
ConcreteDesignCodeFactor_EC2[18]=0.80

