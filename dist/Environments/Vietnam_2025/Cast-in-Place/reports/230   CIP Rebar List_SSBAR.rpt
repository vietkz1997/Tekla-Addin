    row _tmp_1544
    {
        name = "Rebar";
        height = 1;
        visibility = TRUE;
        usecolumns = FALSE;
        rule = "";
        contenttype = "REBAR";
        sorttype = COMBINE;

        valuefield _tmp_2145
        {
            name = "등급";
            location = (24, 0);
            formula = "if (GetValue(\"GRADE\")==\"SD300\") then\r\n\r\n\"D\"\r\nelse\r\n\r\nif (GetValue(\"GRADE\")==\"SD400\") then\r\n\r\n\"HD\"\r\nelse\r\n\r\nif (GetValue(\"GRADE\")==\"SD500\") then\r\n\r\n\"SHD\" \r\nelse\r\n\r\nif (GetValue(\"GRADE\")==\"SD600\") then\r\n\r\n\"UHD\"\r\nelse\r\n\r\nGetValue(\"GRADE\")  \r\n\r\nendif\r\nendif\r\nendif\r\nendif\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n";
            maxnumoflines = 1;
            datatype = STRING;
            class = "";
            cacheable = TRUE;
            formatzeroasempty = FALSE;
            justify = RIGHT;
