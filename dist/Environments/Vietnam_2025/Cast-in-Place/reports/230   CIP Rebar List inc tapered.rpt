            valuefield _tmp_34446
            {
                name = "무게2";
                location = (183, 0);
                formula = "if(GetFieldFormula(\"크기2\")==\"6\")then\r\n  (GetFieldFormula(\"길이2\")*0.249)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기2\")==\"10\")then\r\n  (GetFieldFormula(\"길이2\")*0.560)/1000\r\n else\r\n  if(GetFieldFormula(\"크기2\")==\"13\")then\r\n  (GetFieldFormula(\"길이2\")*0.995)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기2\")==\"16\")then\r\n  (GetFieldFormula(\"길이2\")*1.56)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기2\")==\"19\")then\r\n  (GetFieldFormula(\"길이2\")*2.25)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기2\")==\"22\")then\r\n  (GetFieldFormula(\"길이2\")*3.04)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기2\")==\"25\")then\r\n  (GetFieldFormula(\"길이2\")*3.98)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기2\")==\"29\")then\r\n  (GetFieldFormula(\"길이2\")*5.04)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기2\")==\"32\")then\r\n  (GetFieldFormula(\"길이2\")*6.23)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기2\")==\"35\")then\r\n  (GetFieldFormula(\"길이2\")*7.51)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기2\")==\"38\")then\r\n  (GetFieldFormula(\"길이2\")*8.95)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기2\")==\"41\")then\r\n  (GetFieldFormula(\"길이2\")*10.5)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기2\")==\"51\")then\r\n  (GetFieldFormula(\"길이2\")*15.9)/1000 \r\n else\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif";
                datatype = DOUBLE;
                class = "Weight";
