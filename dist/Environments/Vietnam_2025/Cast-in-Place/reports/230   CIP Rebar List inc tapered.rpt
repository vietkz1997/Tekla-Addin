        valuefield _tmp_4982
        {
            name = "무게1";
            location = (183, 0);
            formula = "if(GetFieldFormula(\"크기\")==\"6\")then\r\n  (GetFieldFormula(\"길이1\")*0.249)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기\")==\"10\")then\r\n  (GetFieldFormula(\"길이1\")*0.560)/1000\r\n else\r\n  if(GetFieldFormula(\"크기\")==\"13\")then\r\n  (GetFieldFormula(\"길이1\")*0.995)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기\")==\"16\")then\r\n  (GetFieldFormula(\"길이1\")*1.56)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기\")==\"19\")then\r\n  (GetFieldFormula(\"길이1\")*2.25)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기\")==\"22\")then\r\n  (GetFieldFormula(\"길이1\")*3.04)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기\")==\"25\")then\r\n  (GetFieldFormula(\"길이1\")*3.98)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기\")==\"29\")then\r\n  (GetFieldFormula(\"길이1\")*5.04)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기\")==\"32\")then\r\n  (GetFieldFormula(\"길이1\")*6.23)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기\")==\"35\")then\r\n  (GetFieldFormula(\"길이1\")*7.51)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기\")==\"38\")then\r\n  (GetFieldFormula(\"길이1\")*8.95)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기\")==\"41\")then\r\n  (GetFieldFormula(\"길이1\")*10.5)/1000 \r\n else\r\n  if(GetFieldFormula(\"크기\")==\"51\")then\r\n  (GetFieldFormula(\"길이1\")*15.9)/1000 \r\n else\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif\r\nendif";
            datatype = DOUBLE;
            class = "Weight";
            cacheable = TRUE;
            justify = RIGHT;
            visibility = TRUE;
            angle = 0;
            length = 7;
            decimals = 2;
            sortdirection = ASCENDING;
            fontname = "Courier New";
