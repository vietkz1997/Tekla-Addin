        valuefield _tmp_10354
        {
            name = "Totals";
            location = (2, 45);
            formula = "if GetValue(\"ADVANCED_OPTION.XS_IMPERIAL\")==\"TRUE\" then\nif GetValue(\"MATERIAL_TYPE\")==\"STEEL\" then\nGetValue(\"TranslatedText(\"albl_Total\")\") +\" \"+GetValue(\"MODEL_TOTAL\")+\" \"+ GetValue(\"TranslatedText(\"albl_parts\")\")+ \": \"+\nformat((GetValue(\"WEIGHT_NET\")*GetValue(\"MODEL_TOTAL\")),\"Weight\",\"lbf\",2)+\" lbf, \"+\nformat((GetValue(\"LENGTH\")*GetValue(\"MODEL_TOTAL\")),\"Length\",\"inch-frac\", 1/16) + \" in\"\n\nelse\nGetValue(\"TranslatedText(\"albl_Total\")\") +\" \"+GetValue(\"MODEL_TOTAL\")+\" \"+ GetValue(\"TranslatedText(\"albl_parts\")\")+ \": \"+\nformat((GetValue(\"WEIGHT_NET\")*GetValue(\"MODEL_TOTAL\")),\"Weight\",\"lbf\",2)+\" lbf, \"+\nformat((GetValue(\"LENGTH\")*GetValue(\"MODEL_TOTAL\")),\"Length\",\"ft-frac\", 1/16) + \" ft-in\"\nendif\n\nelse\n\nGetValue(\"TranslatedText(\"albl_Total\")\") +\" \"+GetValue(\"MODEL_TOTAL\")+\" \"+ GetValue(\"TranslatedText(\"albl_parts\")\")+ \": \"+\nformat((GetValue(\"WEIGHT_NET\")*GetValue(\"MODEL_TOTAL\")),\"Weight\",\"T\",2)+\" T, \"+\nformat((GetValue(\"LENGTH\")*GetValue(\"MODEL_TOTAL\")),\"Length\",\"m\",2)+\" m\"\n\nendif\n\n";
            datatype = STRING;
            class = "";
            cacheable = TRUE;
            justify = LEFT;
            visibility = TRUE;
            angle = 0;
            length = 60;
            decimals = 0;
            sortdirection = NONE;
            fontname = "Courier New";
            fontcolor = 153;
            fonttype = 2;
            fontsize = 5;
            fontratio = 1.5;
            fontstyle = 0;
            fontslant = 0;
            pen = -1;
            oncombine = NONE;
        };

