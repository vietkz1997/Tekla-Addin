<?xml version="1.0" encoding="utf-8"?>
<DwgExportOptions Version="1.1">
  <FileAttributes FileExtension=".dwg" FilePrefix="" FileSuffix="" FileVersion="Dwg.UI.DwgFileVersion.vAC24" />
  <Preferences OpenFolder="false" OutputDirectory=".\CAD" UpdateExisting="false" EmbedImages="false" WithoutBlocks="false" SnapshotToModelSpace="true" SnapshotScale="1.0" CoordinatesToUse="Local" />
  <LayerRules>&lt;?xml version="1.0" encoding="utf-16"?&gt;
&lt;ObjectMappingRules xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"&gt;
  &lt;LayerTemplate /&gt;
  &lt;Version&gt;1.0&lt;/Version&gt;
  &lt;MappingRules&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="PARTS" /&gt;
      &lt;Filter ObjectType="Part" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="REINFORCEMENTS" /&gt;
      &lt;Filter ObjectType="ReinforcementBase" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="DIMENSIONS" /&gt;
      &lt;Filter ObjectType="DimensionBase" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="MARKS" /&gt;
      &lt;Filter ObjectType="MarkBase" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="DETAIL MARKS" /&gt;
      &lt;Filter ObjectType="DetailMark" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="WELD MARKS" /&gt;
      &lt;Filter ObjectType="WeldMark" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="SECTION MARKS" /&gt;
      &lt;Filter ObjectType="SectionMarkBase" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="DRAWING TABLE" /&gt;
      &lt;Filter ObjectType="DrawingTable" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="DRAWING FRAME" /&gt;
      &lt;Filter ObjectType="DrawingFrame" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="VIEW LABEL" /&gt;
      &lt;Filter ObjectType="ViewLabel" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="SYMBOL OBJECTS" /&gt;
      &lt;Filter ObjectType="Symbol" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="TEXT OBJECTS" /&gt;
      &lt;Filter ObjectType="Text" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="TEXT FILES" /&gt;
      &lt;Filter ObjectType="TextFile" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
    &lt;MappingRule&gt;
      &lt;Setting IncludeInExport="true" Color="AsTSObject" LineStyle="AsTSObject" LineWeight="AsTSObject" PaperSpace="false" LayerName="0" /&gt;
      &lt;Filter ObjectType="DrawingObject" FilterName="" GroupingStyle="All" /&gt;
    &lt;/MappingRule&gt;
  &lt;/MappingRules&gt;
&lt;/ObjectMappingRules&gt;</LayerRules>
</DwgExportOptions>