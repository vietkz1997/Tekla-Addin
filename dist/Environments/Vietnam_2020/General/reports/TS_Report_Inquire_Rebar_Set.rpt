        height = 1;
        visibility = TRUE;
        usecolumns = FALSE;
        rule = "if GetValue(\"REBAR.GROUP_TYPE\") == 1 || GetValue(\"REBAR.GROUP_TYPE\") == 2 || GetValue(\"REBAR.GROUP_TYPE\") == 3 || GetValue(\"REBAR.GROUP_TYPE\") == 4 then\n  Output()\nelse\n  StepOver()\nendif";
